{
  "manifest_version": 3,
  "name": "Prismatik Avisos",
  "version": "1.0.0",
  "description": "Acende a fita do Prismatik quando o Claude.ai ou o ChatGPT terminam de responder e quando chega mensagem no WhatsApp Web.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://web.whatsapp.com/*"
      ],
      "js": ["sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Prismatik Avisos",
    "default_popup": "options.html"
  }
}
